<Window x:Class="comixpaint.modals.AddToPaletteForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zur Palette hinzufügen"
        Width="500"
        Height="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF404040">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorText}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Hinzufügen" Width="90" Margin="0,0,8,0" Command="{Binding ConfirmCommand}"/>
            <Button Content="Abbrechen" Width="90" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
