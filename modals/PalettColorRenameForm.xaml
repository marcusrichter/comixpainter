<Window x:Class="comixpaint.modals.PalettColorRenameForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farbe umbennen"
        Width="340"
        Height="150"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF404040">
    <StackPanel Margin="12">
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Übernehmen" Width="90" Margin="0,0,8,0" Command="{Binding ConfirmCommand}"/>
            <Button Content="Abbrechen" Width="90" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
