<Window x:Class="comixpaint.modals.ScaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bild skalieren"
        Width="360"
        Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF404040">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Alte Breite" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentWidthText}" Foreground="White" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alte Höhe" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentHeightText}" Foreground="White" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Neue Breite" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Neue Höhe" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
            <Button Content="OK" Width="75" Margin="0,0,8,0" Command="{Binding OkCommand}"/>
            <Button Content="Abbrechen" Width="75" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
