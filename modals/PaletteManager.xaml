<Window x:Class="comixpaint.modals.PaletteManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palettenverwaltung"
        Width="1000"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF404040">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Palette laden" Width="100" Margin="0,0,8,0" Command="{Binding LoadPaletteCommand}"/>
            <Button Content="Palette ablegen" Width="110" Margin="0,0,8,0" Command="{Binding SavePaletteCommand}"/>
            <CheckBox Content="Löschmodus" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="{Binding DeleteMode, Mode=TwoWay}"/>
            <CheckBox Content="Umbenennen" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="{Binding RenameMode, Mode=TwoWay}"/>
            <TextBlock Text="{Binding PaletteFileName}" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <Border BorderBrush="Gray" BorderThickness="1" Background="#FF323232">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Farben" Foreground="White" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="150"
                                            Height="30"
                                            Margin="2"
                                            Background="{Binding Brush}"
                                            Foreground="{Binding ForegroundBrush}"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.ColorClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Rahmenfarben:" Foreground="White" Margin="2,12,2,4"/>

                        <ItemsControl ItemsSource="{Binding BorderColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="150"
                                            Height="30"
                                            Margin="2"
                                            Background="{Binding Brush}"
                                            Foreground="{Binding ForegroundBrush}"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.ColorClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
